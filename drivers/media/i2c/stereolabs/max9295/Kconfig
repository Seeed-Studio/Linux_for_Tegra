config SL_SER_MAX9295
	tristate "ZED-X serializer support"
	depends on I2C && VIDEO_V4L2 && VIDEO_V4L2_SUBDEV_API && ( SL_DESER_MAX96712 || SL_DESER_MAX9296 )
	help
	  This is an I2C communication driver to setup the MAX9295 serializer
	  for Stereolabs ZED-X camera lineup.

	  To compile this driver as a module, choose M here: the module
	  will be called sl_max9295.
