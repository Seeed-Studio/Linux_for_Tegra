#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3767-0000-common.h>
#include <dt-bindings/pinctrl/pinctrl-tegra.h>
//MFP9 TEGRA234 MAIN GPIO(AC，0)
//MFP10  TEGRA234 MAIN GPIO(Z，7)
//MPP2   TEGRA_AON_GPIO(G, 6)

#define CAM0_RST_L	TEGRA234_AON_GPIO(CC, 3)
#define CAM0_PWDN   TEGRA234_MAIN_GPIO(H, 6)
#define PWR_EN      TEGRA234_MAIN_GPIO(AC, 7)
#define SYNC_OUT   	TEGRA234_MAIN_GPIO(G, 6)
#define SYNC_IN    	TEGRA234_MAIN_GPIO(AC, 4) //
#define SYNC_SEL   	TEGRA234_MAIN_GPIO(AC, 2)
#define PPS_TRIGGER	TEGRA234_MAIN_GPIO(AC, 0) //
#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)
/{
	vdd_1v8_ls: regulator-vdd-1v8-ls {
			compatible = "regulator-fixed";
			regulator-name = "VDD_1V8_LS";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
	};


	/* Orbbec Camera configuration */
	tegra-capture-vi {
		num-channels = <32>;
		ports {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0x0>;
				status = "okay";
				g2xx_vi_in0: endpoint {
					status = "okay";
					vc-id = <0>;
					port-index = <0>; //0
					bus-width = <4>;
					remote-endpoint = <&g2xx_csi_out0>;
				};
			};
			port@1 {
				reg = <0x1>;
				status = "okay";
				g2xx_vi_in1: endpoint {
					status = "okay";
					vc-id = <1>;
					port-index = <1>; //0
					bus-width = <4>;
					remote-endpoint = <&g2xx_csi_out1>;
				};
			};
			port@2 {
				reg = <0x2>;
				status = "okay";
				g2xx_vi_in2: endpoint {
					status = "okay";
					vc-id = <2>;
					port-index = <2>; //0
					bus-width = <4>;
					remote-endpoint = <&g2xx_csi_out2>;
				};
			};
			port@3 {
				reg = <0x3>;
				status = "okay";
				g2xx_vi_in3: endpoint {
					status = "okay";
					vc-id = <3>;
					port-index = <3>; //0
					bus-width = <4>;
					remote-endpoint = <&g2xx_csi_out3>;
				};
			};
		};
	};

	tegra-camera-platform {
		#if 0
		compatible = "nvidia, tegra-camera-platform";
		num_csi_lanes = <16>;
		max_lane_speed = <20000000>;
		min_bits_per_pixel = <8>;
		vi_peak_byte_per_pixel = <2>;
		vi_bw_margin_pct = <25>;
		isp_peak_byte_per_pixel = <5>;
		isp_bw_margin_pct = <25>;
		#endif
		modules {
			status = "okay";
			module0 {
				status = "okay";
				badge = "g2xx_0";
				position = "bottomleft";
				orientation = "1";

				drivernode0 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Declare the device-tree hierarchy to driver instance */
					sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/g0m0@66";
				};

				drivernode1 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Declare the device-tree hierarchy to driver instance */
					sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/g0m1@67";
				};

				drivernode2 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Declare the device-tree hierarchy to driver instance */
					sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/g0m2@68";
				};

				drivernode3 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Declare the device-tree hierarchy to driver instance */
					sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/g0m3@69";
				};
			};
		};
	};

	obc_cam_sync {
		compatible = "orbbec,obc_cam_sync";
		//sync-in-gpios = <&gpio SYNC_IN GPIO_ACTIVE_HIGH>;
		//sync-out-gpios = <&gpio_aon SYNC_OUT GPIO_ACTIVE_HIGH>;  //Use hrtimer to generate trigger signals
		pwms = <&pwm7 0 66666666>; //33333333>; //Use PWM to generate trigger signals, Default PWM mode, if use hrtimer comment out this line
	};
	bus@0 {
		/* NVCSI configuration */
		host1x@13e00000 {
			nvcsi@15a00000 {
				#address-cells = <1>;
				#size-cells = <0>;

				num-channels = <32>;

				channel@0 {
					reg = <0x0>;
					status = "okay";
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							status = "okay";
							g2xx_csi_in0: endpoint@0 {
								status = "okay";
								port-index = <0>; //0
								bus-width = <4>;
								remote-endpoint = <&g2m0_0_out>;
							};
						};
						port@1 {
							reg = <1>;
							status = "okay";
							g2xx_csi_out0: endpoint@1 {
								status = "okay";
								remote-endpoint = <&g2xx_vi_in0>;
							};
						};
					};
				};
				channel@1 {
					reg = <0x1>;
					status = "okay";
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							status = "okay";
							g2xx_csi_in1: endpoint@2 {
								status = "okay";
								port-index = <1>; //0
								bus-width = <4>;
								remote-endpoint = <&g2m0_1_out>;
							};
						};
						port@1 {
							reg = <1>;
							status = "okay";
							g2xx_csi_out1: endpoint@3 {
								status = "okay";
								remote-endpoint = <&g2xx_vi_in1>;
							};
						};
					};
				};
				channel@2 {
					reg = <0x2>;
					status = "okay";
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							status = "okay";
							g2xx_csi_in2: endpoint@4 {
								status = "okay";
								port-index = <2>; //0
								bus-width = <4>;
								remote-endpoint = <&g2m0_2_out>;
							};
						};
						port@1 {
							reg = <1>;
							status = "okay";
							g2xx_csi_out2: endpoint@5 {
								status = "okay";
								remote-endpoint = <&g2xx_vi_in2>;
							};
						};
					};
				};
				channel@3 {
					reg = <0x3>;
					status = "okay";
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							status = "okay";
							g2xx_csi_in3: endpoint@6 {
								status = "okay";
								port-index = <3>; //0
								bus-width = <4>;
								remote-endpoint = <&g2m0_3_out>;
							};
						};
						port@1 {
							reg = <1>;
							status = "okay";
							g2xx_csi_out3: endpoint@7 {
								status = "okay";
								remote-endpoint = <&g2xx_vi_in3>;
							};
						};
					};
				};
			};
		};

		/* GPIO configuration */
		gpio@2200000 {
			camera-control-output-high1 {
				gpio-hog;
				output-high;
				gpios = <CAM0_PWDN 0>;
				label = "cam0-pwdn";
			};
		};

		gpio@c2f0000 {
			camera-control-output-high2 {
				gpio-hog;
				output-high;
				gpios = <CAM0_RST_L 0>;
				label = "cam0-rst";
			};
		};


		camera_power_enable {
			gpio-hog;
			output-high;
			gpios = <PWR_EN GPIO_ACTIVE_HIGH>;
			label = "cam-pwr-en";
		};

		camera_fsync_input {
			gpio-hog;
			input;
			gpios = <SYNC_OUT 0>;
			label = "fsync-in";
		};

		camera_fsync_sel {
			gpio-hog;
			output-high;
			gpios = <SYNC_SEL 0>;
			label = "fsync-sel";
		};

		/* I2C configuration */
		i2c@3180000 {
			status = "okay";
			clock-frequency = <400000>;

			#address-cells = <1>;
			#size-cells = <0>;

			g2m0_3: g2m3@69 {
				status = "okay";
				reg = <0x69>;
				compatible = "nv,nv-cam";
				nvidia,gmsl-ser-device=<&ser3>;
				// pps-gpios = <&gpio PPS_TRIGGER GPIO_ACTIVE_LOW>;
//				pwdn-gpios = <&CAM_SER_LABEL 0 GPIO_ACTIVE_HIGH>;
				nv,pwdn-sleep-us = <500000>;

				// reset-gpios = <&CAM_SER_LABEL 7 GPIO_ACTIVE_HIGH>;

				physical_w = "15.0";
				physical_h = "12.5";

				sensor_model = "isx031";

				use_sensor_mode_id = "true";

				nv,reg-bits = <16>;
				nv,val-bits = <8>;

				nv,chip-id-regs = <0x7e8a 0x7e8b>;
				nv,chip-id-masks = <0xff 0x0f>;
				nv,chip-id-vals = <0x31 0x0>;

				nv,wait-ms-cmd = <0x32>;

				nv,mode-common-cmd = <
					0x8a01 0x00 /* Stream off */
					0x8af0 0x01
					0xbf14 0x01 /* SW reset */
				>;

				nv,start-stream-cmd = <
					0x8a01 0x80 /* Stream on */
				>;

				nv,stop-stream-cmd = <0x8a01 0x00>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						g2m0_3_out: endpoint {
							vc-id = <3>;
							port-index = <0>; //0
							bus-width = <3>;
							remote-endpoint = <&g2xx_csi_in3>;
						};
					};
				};
				mode0 {
					nv,mode-cmd = <0>;
			#if defined(CAM_USE_AD_GAIN)
					nv,gain-type = "ad";

					nv,again-min = <16>;
					nv,again-max = <248>;
					nv,again-regs = <0x3508 0x3509>;
					nv,again-source-masks = <0xf0 0x0f>;
					nv,again-target-masks = <0x0f 0xf0>;

					nv,dgain-min = <1024>;
					nv,dgain-max = <16383>;
					nv,dgain-regs = <0x350a 0x350b 0x350c>;
					nv,dgain-source-masks = <0x3c00 0x3fc 0x3>;
					nv,dgain-target-masks = <0x0f 0xff 0xc000>;
			#endif

					mclk_khz = "24000";
					set_mode_delay_ms = "5000";
					num_lanes = "4";
					tegra_sinterface = "b";
					vc_id = "3";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
			#ifdef GMSL_TEGRA_LANE_POLARITY_SWAP
					lane_polarity = "6";
			#endif
					//1536
					active_w = "1920";
					active_h = "1536";

					readout_orientation = "0";
					csi_pixel_bit_depth = "16";
					dynamic_pixel_bit_depth = "16";
					mode_type = "yuv";
					pixel_phase = "uyvy";


					line_length = "2200";
					inherent_gain = "1";
					pix_clk_hz = "200000000"; 
			//		pix_clk_hz = "88473600"; 
					serdes_link_freq = "300000000";
					// serdes_pix_clk_hz = "375000000";

			#if defined(CAM_USE_AD_GAIN)
					gain_factor = "16384";
					min_gain_val = "16384"; /* 1.00x */
					max_gain_val = "4062984"; /* 247.984863281x ((16 - 8/16) * (16 - 1/1024)) */
					step_gain_val = "1";
					default_gain = "16384"; /* 1.00x */
			#else
					gain_factor = "1000";
					min_gain_val = "1"; /* 1.00x */
					max_gain_val = "30000"; /* 15.5x (16 - 1/16) */
					step_gain_val = "300";
					default_gain = "16"; /* 1.00x */
			#endif

					min_hdr_ratio = "1";
					max_hdr_ratio = "1";

					framerate_factor = "1000000";
					min_framerate = "30000000"; /* 30.0 fps */
					max_framerate = "30000000"; /* 30.0 fps */
					step_framerate = "1";
					default_framerate = "30000000"; /* 30.0 fps */

					exposure_factor = "1000000";
					min_exp_time = "59"; /* us */
					max_exp_time = "33333"; /* us */
					step_exp_time = "1";
					default_exp_time = "33333"; /* us */

					embedded_metadata_height = "0";
				};

				gmsl-link { 
					src-csi-port = "d";  		/**< Sensor to serializer CSI port connection. */
					dst-csi-port = "b";			/**< Deserializer to Jetson CSI port connection. */
					serdes-csi-link = "d";		/**< GMSL link between serializer and deserializer devices. */
					csi-mode = "1x4";			/**< Deserializer CSI mode. */
					st-vc = <3>;   				/**< Default sensor virtual channel. */
					vc-id = <3>;				/**< Destination virtual channel (user-defined). */
					num-lanes = <2>;			/**< Sensor's CSI lane configuration. */
				};
			};
			g2m0_2: g2m2@68 {
				status = "okay";
				reg = <0x68>;
				compatible = "nv,nv-cam";
				// pps-gpios = <&gpio PPS_TRIGGER GPIO_ACTIVE_LOW>;
//				pwdn-gpios = <&CAM_SER_LABEL 0 GPIO_ACTIVE_HIGH>;
				nv,pwdn-sleep-us = <500000>;

				// reset-gpios = <&CAM_SER_LABEL 7 GPIO_ACTIVE_HIGH>;

				physical_w = "15.0";
				physical_h = "12.5";

				sensor_model = "isx031";

				use_sensor_mode_id = "true";

				nv,reg-bits = <16>;
				nv,val-bits = <8>;

				nv,chip-id-regs = <0x7e8a 0x7e8b>;
				nv,chip-id-masks = <0xff 0x0f>;
				nv,chip-id-vals = <0x31 0x0>;

				nv,wait-ms-cmd = <0x32>;

				nv,mode-common-cmd = <
					0x8a01 0x00 /* Stream off */
					0x8af0 0x01
					0xbf14 0x01 /* SW reset */
				>;

				nv,start-stream-cmd = <
					0x8a01 0x80 /* Stream on */
				>;

				nv,stop-stream-cmd = <0x8a01 0x00>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						g2m0_2_out: endpoint {
							vc-id = <2>;
							port-index = <0>; //0
							bus-width = <2>;
							remote-endpoint = <&g2xx_csi_in2>;
						};
					};
				};
				mode0 {
					nv,mode-cmd = <0>;
			#if defined(CAM_USE_AD_GAIN)
					nv,gain-type = "ad";

					nv,again-min = <16>;
					nv,again-max = <248>;
					nv,again-regs = <0x3508 0x3509>;
					nv,again-source-masks = <0xf0 0x0f>;
					nv,again-target-masks = <0x0f 0xf0>;

					nv,dgain-min = <1024>;
					nv,dgain-max = <16383>;
					nv,dgain-regs = <0x350a 0x350b 0x350c>;
					nv,dgain-source-masks = <0x3c00 0x3fc 0x3>;
					nv,dgain-target-masks = <0x0f 0xff 0xc000>;
			#endif

					mclk_khz = "24000";
					set_mode_delay_ms = "5000";
					num_lanes = "4";
					tegra_sinterface = "b";
					vc_id = "2";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
			#ifdef GMSL_TEGRA_LANE_POLARITY_SWAP
					lane_polarity = "6";
			#endif
					//1536
					active_w = "1920";
					active_h = "1536";

					readout_orientation = "0";
					csi_pixel_bit_depth = "16";
					dynamic_pixel_bit_depth = "16";
					mode_type = "yuv";
					pixel_phase = "uyvy";


					line_length = "2200";
					inherent_gain = "1";
					pix_clk_hz = "200000000"; 
			//		pix_clk_hz = "88473600"; 
					serdes_link_freq = "300000000";
					// serdes_pix_clk_hz = "375000000";

			#if defined(CAM_USE_AD_GAIN)
					gain_factor = "16384";
					min_gain_val = "16384"; /* 1.00x */
					max_gain_val = "4062984"; /* 247.984863281x ((16 - 8/16) * (16 - 1/1024)) */
					step_gain_val = "1";
					default_gain = "16384"; /* 1.00x */
			#else
					gain_factor = "1000";
					min_gain_val = "1"; /* 1.00x */
					max_gain_val = "30000"; /* 15.5x (16 - 1/16) */
					step_gain_val = "300";
					default_gain = "16"; /* 1.00x */
			#endif

					min_hdr_ratio = "1";
					max_hdr_ratio = "1";

					framerate_factor = "1000000";
					min_framerate = "30000000"; /* 30.0 fps */
					max_framerate = "30000000"; /* 30.0 fps */
					step_framerate = "1";
					default_framerate = "30000000"; /* 30.0 fps */

					exposure_factor = "1000000";
					min_exp_time = "59"; /* us */
					max_exp_time = "33333"; /* us */
					step_exp_time = "1";
					default_exp_time = "33333"; /* us */

					embedded_metadata_height = "0";
				};

				gmsl-link { 
					src-csi-port = "c";  		/**< Sensor to serializer CSI port connection. */
					dst-csi-port = "b";			/**< Deserializer to Jetson CSI port connection. */
					serdes-csi-link = "c";		/**< GMSL link between serializer and deserializer devices. */
					csi-mode = "1x4";			/**< Deserializer CSI mode. */
					st-vc = <2>;   				/**< Default sensor virtual channel. */
					vc-id = <2>;				/**< Destination virtual channel (user-defined). */
					num-lanes = <2>;			/**< Sensor's CSI lane configuration. */
				};
			};
			g2m0_1: g2m1@67 {
				status = "okay";
				reg = <0x67>;
				compatible = "nv,nv-cam";
				nvidia,gmsl-ser-device=<&ser1>;
				// pps-gpios = <&gpio PPS_TRIGGER GPIO_ACTIVE_LOW>;
//				pwdn-gpios = <&CAM_SER_LABEL 0 GPIO_ACTIVE_HIGH>;
				nv,pwdn-sleep-us = <500000>;

				// reset-gpios = <&CAM_SER_LABEL 7 GPIO_ACTIVE_HIGH>;

				physical_w = "15.0";
				physical_h = "12.5";

				sensor_model = "isx031";

				use_sensor_mode_id = "true";

				nv,reg-bits = <16>;
				nv,val-bits = <8>;

				nv,chip-id-regs = <0x7e8a 0x7e8b>;
				nv,chip-id-masks = <0xff 0x0f>;
				nv,chip-id-vals = <0x31 0x0>;

				nv,wait-ms-cmd = <0x32>;

				nv,mode-common-cmd = <
					0x8a01 0x00 /* Stream off */
					0x8af0 0x01
					0xbf14 0x01 /* SW reset */
				>;

				nv,start-stream-cmd = <
					0x8a01 0x80 /* Stream on */
				>;

				nv,stop-stream-cmd = <0x8a01 0x00>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						g2m0_1_out: endpoint {
							vc-id = <1>;
							port-index = <0>; //0
							bus-width = <2>;
							remote-endpoint = <&g2xx_csi_in1>;
						};
					};
				};
				mode0 {
					nv,mode-cmd = <0>;
			#if defined(CAM_USE_AD_GAIN)
					nv,gain-type = "ad";

					nv,again-min = <16>;
					nv,again-max = <248>;
					nv,again-regs = <0x3508 0x3509>;
					nv,again-source-masks = <0xf0 0x0f>;
					nv,again-target-masks = <0x0f 0xf0>;

					nv,dgain-min = <1024>;
					nv,dgain-max = <16383>;
					nv,dgain-regs = <0x350a 0x350b 0x350c>;
					nv,dgain-source-masks = <0x3c00 0x3fc 0x3>;
					nv,dgain-target-masks = <0x0f 0xff 0xc000>;
			#endif

					mclk_khz = "24000";
					set_mode_delay_ms = "5000";
					num_lanes = "4";
					tegra_sinterface = "a";
					vc_id = "1";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
			#ifdef GMSL_TEGRA_LANE_POLARITY_SWAP
					lane_polarity = "6";
			#endif
					//1536
					active_w = "1920";
					active_h = "1536";

					readout_orientation = "0";
					csi_pixel_bit_depth = "16";
					dynamic_pixel_bit_depth = "16";
					mode_type = "yuv";
					pixel_phase = "uyvy";


					line_length = "2200";
					inherent_gain = "1";
					pix_clk_hz = "200000000"; 
			//		pix_clk_hz = "88473600"; 
					serdes_link_freq = "300000000";
					// serdes_pix_clk_hz = "375000000";

			#if defined(CAM_USE_AD_GAIN)
					gain_factor = "16384";
					min_gain_val = "16384"; /* 1.00x */
					max_gain_val = "4062984"; /* 247.984863281x ((16 - 8/16) * (16 - 1/1024)) */
					step_gain_val = "1";
					default_gain = "16384"; /* 1.00x */
			#else
					gain_factor = "1000";
					min_gain_val = "1"; /* 1.00x */
					max_gain_val = "30000"; /* 15.5x (16 - 1/16) */
					step_gain_val = "300";
					default_gain = "16"; /* 1.00x */
			#endif

					min_hdr_ratio = "1";
					max_hdr_ratio = "1";

					framerate_factor = "1000000";
					min_framerate = "30000000"; /* 30.0 fps */
					max_framerate = "30000000"; /* 30.0 fps */
					step_framerate = "1";
					default_framerate = "30000000"; /* 30.0 fps */

					exposure_factor = "1000000";
					min_exp_time = "59"; /* us */
					max_exp_time = "33333"; /* us */
					step_exp_time = "1";
					default_exp_time = "33333"; /* us */

					embedded_metadata_height = "0";
				};

				gmsl-link { 
					src-csi-port = "b";  		/**< Sensor to serializer CSI port connection. */
					dst-csi-port = "a";			/**< Deserializer to Jetson CSI port connection. */
					serdes-csi-link = "b";		/**< GMSL link between serializer and deserializer devices. */
					csi-mode = "1x4";			/**< Deserializer CSI mode. */
					st-vc = <1>;   				/**< Default sensor virtual channel. */
					vc-id = <1>;				/**< Destination virtual channel (user-defined). */
					num-lanes = <2>;			/**< Sensor's CSI lane configuration. */
				};
			};
			g2m0_0: g2m0@66 {
				status = "okay";
				reg = <0x66>;
				compatible = "nv,nv-cam";
				nvidia,gmsl-ser-device=<&ser0>;
				// pps-gpios = <&gpio PPS_TRIGGER GPIO_ACTIVE_LOW>;
//				pwdn-gpios = <&CAM_SER_LABEL 0 GPIO_ACTIVE_HIGH>;
				nv,pwdn-sleep-us = <500000>;

				// reset-gpios = <&CAM_SER_LABEL 7 GPIO_ACTIVE_HIGH>;

				physical_w = "15.0";
				physical_h = "12.5";

				sensor_model = "isx031";

				use_sensor_mode_id = "true";

				nv,reg-bits = <16>;
				nv,val-bits = <8>;

				nv,chip-id-regs = <0x7e8a 0x7e8b>;
				nv,chip-id-masks = <0xff 0x0f>;
				nv,chip-id-vals = <0x31 0x0>;

				nv,wait-ms-cmd = <0x32>;

				nv,mode-common-cmd = <
					0x8a01 0x00 /* Stream off */
					0x8af0 0x01
					0xbf14 0x01 /* SW reset */
				>;

				nv,start-stream-cmd = <
					0x8a01 0x80 /* Stream on */
				>;

				nv,stop-stream-cmd = <0x8a01 0x00>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						g2m0_0_out: endpoint {
							vc-id = <0>;
							port-index = <0>; //0
							bus-width = <2>;
							remote-endpoint = <&g2xx_csi_in0>;
						};
					};
				};
				mode0 {
					nv,mode-cmd = <0>;
			#if defined(CAM_USE_AD_GAIN)
					nv,gain-type = "ad";

					nv,again-min = <16>;
					nv,again-max = <248>;
					nv,again-regs = <0x3508 0x3509>;
					nv,again-source-masks = <0xf0 0x0f>;
					nv,again-target-masks = <0x0f 0xf0>;

					nv,dgain-min = <1024>;
					nv,dgain-max = <16383>;
					nv,dgain-regs = <0x350a 0x350b 0x350c>;
					nv,dgain-source-masks = <0x3c00 0x3fc 0x3>;
					nv,dgain-target-masks = <0x0f 0xff 0xc000>;
			#endif

					mclk_khz = "24000";
					set_mode_delay_ms = "5000";
					num_lanes = "4";
					tegra_sinterface = "a";
					vc_id = "0";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
			#ifdef GMSL_TEGRA_LANE_POLARITY_SWAP
					lane_polarity = "6";
			#endif
					//1536
					active_w = "1920";
					active_h = "1536";

					readout_orientation = "0";
					csi_pixel_bit_depth = "16";
					dynamic_pixel_bit_depth = "16";
					mode_type = "yuv";
					pixel_phase = "uyvy";


					line_length = "2200";
					inherent_gain = "1";
					pix_clk_hz = "200000000"; 
			//		pix_clk_hz = "88473600"; 
					serdes_link_freq = "300000000";
					// serdes_pix_clk_hz = "375000000";

			#if defined(CAM_USE_AD_GAIN)
					gain_factor = "16384";
					min_gain_val = "16384"; /* 1.00x */
					max_gain_val = "4062984"; /* 247.984863281x ((16 - 8/16) * (16 - 1/1024)) */
					step_gain_val = "1";
					default_gain = "16384"; /* 1.00x */
			#else
					gain_factor = "1000";
					min_gain_val = "1"; /* 1.00x */
					max_gain_val = "30000"; /* 15.5x (16 - 1/16) */
					step_gain_val = "300";
					default_gain = "16"; /* 1.00x */
			#endif

					min_hdr_ratio = "1";
					max_hdr_ratio = "1";

					framerate_factor = "1000000";
					min_framerate = "30000000"; /* 30.0 fps */
					max_framerate = "30000000"; /* 30.0 fps */
					step_framerate = "1";
					default_framerate = "30000000"; /* 30.0 fps */

					exposure_factor = "1000000";
					min_exp_time = "59"; /* us */
					max_exp_time = "33333"; /* us */
					step_exp_time = "1";
					default_exp_time = "33333"; /* us */

					embedded_metadata_height = "0";
				};

				gmsl-link { 
					src-csi-port = "a";  		/**< Sensor to serializer CSI port connection. */
					dst-csi-port = "a";			/**< Deserializer to Jetson CSI port connection. */
					serdes-csi-link = "a";		/**< GMSL link between serializer and deserializer devices. */
					csi-mode = "1x4";			/**< Deserializer CSI mode. */
					st-vc = <0>;   				/**< Default sensor virtual channel. */
					vc-id = <0>;				/**< Destination virtual channel (user-defined). */
					num-lanes = <2>;			/**< Sensor's CSI lane configuration. */
				};
			};
			//4 max9295  serializer connect to 4 camera
			ser_prim: max9295_prim@50 {
				compatible = "maxim,max9295";
				reg = <0x50>;
				is-prim-ser; /* primary ser device */
			};
			ser0: max9295_0@60 {
				compatible = "maxim,max9295";
				reg = <0x60>;
				gmsl-dser-device = <&dser0>;
			};
			ser1: max9295_1@61 {
				compatible = "maxim,max9295";
				reg = <0x61>;
				gmsl-dser-device = <&dser0>;
			};
			ser2: max9295_2@62 {
				compatible = "maxim,max9295";
				reg = <0x62>;
				gmsl-dser-device = <&dser0>;
			};
			ser3: max9295_3@63 {
				compatible = "maxim,max9295";
				reg = <0x63>;
				gmsl-dser-device = <&dser0>;
			};

			dser0: max96712@29 {
				status = "okay";
				reg = <0x29>; //0x52>>1
				compatible = "maxim,max96712";
				index = <0>;
				csi-mode = "2x4"; //2*4lane
				seri-addr = <0x60>;
				proxy-addr = <0x66>;
				real-addr = <0x1a>;
				reset-gpios = <&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
				fsync_mfp_index = <2>;
				pps_mfp_index = <9>;
			};
		};
	};
};