					zedx_left6: zedx_left_6@48 {
						compatible = "stereolabs,zedx";
						reg = <0x48>;

						ZED_ORIN_CLKS

						devnode = "video12";
						sync_sensor = "ZED_CAM6";
						sync_sensor_index = <1>;

						zedx-id = "10";
						channel = "b";

						has-eeprom;
						eeprom-addr = <0x54>;

						AR0234_MODES_B("0", "serial_g", "0")

						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							port@0 {
								reg = <0>;
								zedx_ar0234_out12: endpoint {
									vc-id = <0>;
									port-index = <6>;
									opt-csi-port = "a";
									bus-width = <NUM_LANES_B>;
									i2c-cc = <0>;
