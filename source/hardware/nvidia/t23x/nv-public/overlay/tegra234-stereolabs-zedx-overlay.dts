#define AR0234_MODES(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY) \
	AR0234_MODES_LANES_CLK(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY, NUM_LANES, "299000000")

#define AR0234_MODES_A(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY) \
	AR0234_MODES_LANES_CLK(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY, NUM_LANES_A, "598000000")

#define AR0234_MODES_B(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY) \
	AR0234_MODES_LANES_CLK(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY, NUM_LANES_B, "598000000")

#define ZEDX_CAMERA_MODULE(ID, BADGE, POSITION, DEVNAME, PROC_DEV_TREE) \
	module##ID { \
		badge = BADGE; \
		position = POSITION; \
		orientation = "1"; \
		drivernode0 { \
			pcl_id = "v4l2_sensor"; \
			devname = DEVNAME; \
			proc-device-tree = PROC_DEV_TREE; \
		}; \
	};

#define ZEDX_ONE_GS_VI_PORT(ID, REG_ID, VC_ID, VI_PORT_INDEX) \
	port@REG_ID { \
		reg = <REG_ID>; \
		zedxone_gs_vi_in##ID: endpoint { \
			vc-id = <VC_ID>; \
			port-index = <VI_PORT_INDEX>; \
			bus-width = <NUM_LANES>; \
			remote-endpoint = <&zedxone_gs_csi_out##ID>; \
		}; \
	};

#define ZEDX_ONE_GS_VI_PORT_A(ID, REG_ID, VC_ID, VI_PORT_INDEX) \
	port@REG_ID { \
		reg = <REG_ID>; \
		zedxone_gs_vi_in##ID: endpoint { \
			vc-id = <VC_ID>; \
			port-index = <VI_PORT_INDEX>; \
			bus-width = <NUM_LANES_A>; \
			remote-endpoint = <&zedxone_gs_csi_out##ID>; \
		}; \
	};

#define ZEDX_ONE_GS_VI_PORT_B(ID, REG_ID, VC_ID, VI_PORT_INDEX) \
	port@REG_ID { \
		reg = <REG_ID>; \
		zedxone_gs_vi_in##ID: endpoint { \
			vc-id = <VC_ID>; \
			port-index = <VI_PORT_INDEX>; \
			bus-width = <NUM_LANES_B>; \
			remote-endpoint = <&zedxone_gs_csi_out##ID>; \
		}; \
	};

#define ZEDX_ONE_GS_CSI_CHANNEL(ID, REG_ID, CSI_PORT_INDEX) \
	channel@REG_ID { \
		reg = <REG_ID>; \
		ports { \
			#address-cells = <1>; \
			#size-cells = <0>; \
			port@0 { \
				reg = <0>; \
				zedxone_gs_csi_in##ID: endpoint@0 { \
					port-index = <CSI_PORT_INDEX>; \
					bus-width = <NUM_LANES>; \
					remote-endpoint = <&zedxone_gs_out##ID>; \
				}; \
			}; \
			port@1 { \
				reg = <1>; \
				zedxone_gs_csi_out##ID: endpoint@1 { \
					remote-endpoint = <&zedxone_gs_vi_in##ID>; \
				}; \
			}; \
		}; \
	};

#define ZEDX_ONE_GS_CSI_CHANNEL_A(ID, REG_ID, CSI_PORT_INDEX) \
	channel@REG_ID { \
		reg = <REG_ID>; \
		ports { \
			#address-cells = <1>; \
			#size-cells = <0>; \
			port@0 { \
				reg = <0>; \
				zedxone_gs_csi_in##ID: endpoint@0 { \
					port-index = <CSI_PORT_INDEX>; \
					bus-width = <NUM_LANES_A>; \
					remote-endpoint = <&zedxone_gs_out##ID>; \
				}; \
			}; \
			port@1 { \
				reg = <1>; \
				zedxone_gs_csi_out##ID: endpoint@1 { \
					remote-endpoint = <&zedxone_gs_vi_in##ID>; \
				}; \
			}; \
		}; \
	};

#define ZEDX_ONE_GS_CSI_CHANNEL_B(ID, REG_ID, CSI_PORT_INDEX) \
	channel@REG_ID { \
		reg = <REG_ID>; \
		ports { \
			#address-cells = <1>; \
			#size-cells = <0>; \
			port@0 { \
				reg = <0>; \
				zedxone_gs_csi_in##ID: endpoint@0 { \
					port-index = <CSI_PORT_INDEX>; \
					bus-width = <NUM_LANES_B>; \
					remote-endpoint = <&zedxone_gs_out##ID>; \
				}; \
			}; \
			port@1 { \
				reg = <1>; \
				zedxone_gs_csi_out##ID: endpoint@1 { \
					remote-endpoint = <&zedxone_gs_vi_in##ID>; \
				}; \
			}; \
		}; \
	};

/ {

	overlay-name = ZEDX_OVERLAY_NAME;
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

	fragment@0 {
		target-path = "/";
		__overlay__ {

			tegra-capture-vi {
				num-channels = <24>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						zedx_vi_in0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out0>;
						};
					};

					port@1 {
						reg = <1>;
						zedx_vi_in1: endpoint {
							vc-id = <1>;
							port-index = <0>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out1>;
						};
					};

					port@2 {
						reg = <2>;
						zedx_vi_in2: endpoint {
							vc-id = <2>;
							port-index = <0>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out2>;
						};
					};

					port@3 {
						reg = <3>;
						zedx_vi_in3: endpoint {
							vc-id = <3>;
							port-index = <0>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out3>;
						};
					};

					port@4 {
						reg = <4>;
						zedx_vi_in4: endpoint {
							vc-id = <0>;
							port-index = <2>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out4>;
						};
					};

					port@5 {
						reg = <5>;
						zedx_vi_in5: endpoint {
							vc-id = <1>;
							port-index = <2>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out5>;
						};
					};

					port@6 {
						reg = <6>;
						zedx_vi_in6: endpoint {
							vc-id = <2>;
							port-index = <2>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out6>;
						};
					};

					port@7 {
						reg = <7>;
						zedx_vi_in7: endpoint {
							vc-id = <3>;
							port-index = <2>;
							bus-width = <NUM_LANES_A>;
							remote-endpoint = <&zedx_csi_out7>;
						};
					};

					port@8 {
						reg = <8>;
						zedx_vi_in8: endpoint {
							vc-id = <0>;
							port-index = <4>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out8>;
						};
					};

					port@9 {
						reg = <9>;
						zedx_vi_in9: endpoint {
							vc-id = <1>;
							port-index = <4>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out9>;
						};
					};

					port@10 {
						reg = <10>;
						zedx_vi_in10: endpoint {
							vc-id = <2>;
							port-index = <4>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out10>;
						};
					};

					port@11 {
						reg = <11>;
						zedx_vi_in11: endpoint {
							vc-id = <3>;
							port-index = <4>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out11>;
						};
					};

					port@12 {
						reg = <12>;
						zedx_vi_in12: endpoint {
							vc-id = <0>;
							port-index = <5>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out12>;
						};
					};

					port@13 {
						reg = <13>;
						zedx_vi_in13: endpoint {
							vc-id = <1>;
							port-index = <5>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out13>;
						};
					};

					port@14 {
						reg = <14>;
						zedx_vi_in14: endpoint {
							vc-id = <2>;
							port-index = <5>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out14>;
						};
					};

					port@15 {
						reg = <15>;
						zedx_vi_in15: endpoint {
							vc-id = <3>;
							port-index = <5>;
							bus-width = <NUM_LANES_B>;
							remote-endpoint = <&zedx_csi_out15>;
						};
					};

					ZEDX_ONE_GS_VI_PORT_A(0, 16, 0, 0)
					ZEDX_ONE_GS_VI_PORT_A(1, 17, 2, 0)
					ZEDX_ONE_GS_VI_PORT_A(2, 18, 0, 2)
					ZEDX_ONE_GS_VI_PORT_A(3, 19, 2, 2)
					ZEDX_ONE_GS_VI_PORT_B(4, 20, 0, 4)
					ZEDX_ONE_GS_VI_PORT_B(5, 21, 2, 4)
					ZEDX_ONE_GS_VI_PORT_B(6, 22, 0, 5)
					ZEDX_ONE_GS_VI_PORT_B(7, 23, 2, 5)

				};
			};

			BOARD_GPIOS_SET

			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				num_csi_lanes = <16>;
				max_lane_speed = <2000000>;
				min_bits_per_pixel = <10>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;
				modules {
					ZEDX_CAMERA_MODULE(0, "zedx_left0_ar0234", "frontleft", ZEDX_DEVNAME_LEFT0, ZEDX_PROC_LEFT0)
					ZEDX_CAMERA_MODULE(1, "zedx_right0_ar0234", "frontright", ZEDX_DEVNAME_RIGHT0, ZEDX_PROC_RIGHT0)
					ZEDX_CAMERA_MODULE(2, "zedxone_gs0_ar0234", "front", ZEDX_DEVNAME_ONE_GS0, ZEDX_PROC_ONE_GS0)
					ZEDX_CAMERA_MODULE(3, "zedx_left1_ar0234", "frontleft", ZEDX_DEVNAME_LEFT1, ZEDX_PROC_LEFT1)
					ZEDX_CAMERA_MODULE(4, "zedx_right1_ar0234", "frontright", ZEDX_DEVNAME_RIGHT1, ZEDX_PROC_RIGHT1)
					ZEDX_CAMERA_MODULE(5, "zedxone_gs1_ar0234", "front", ZEDX_DEVNAME_ONE_GS1, ZEDX_PROC_ONE_GS1)
					ZEDX_CAMERA_MODULE(6, "zedx_left2_ar0234", "rearleft", ZEDX_DEVNAME_LEFT2, ZEDX_PROC_LEFT2)
					ZEDX_CAMERA_MODULE(7, "zedx_right2_ar0234", "rearright", ZEDX_DEVNAME_RIGHT2, ZEDX_PROC_RIGHT2)
					ZEDX_CAMERA_MODULE(8, "zedxone_gs2_ar0234", "rear", ZEDX_DEVNAME_ONE_GS2, ZEDX_PROC_ONE_GS2)
					ZEDX_CAMERA_MODULE(9, "zedx_left3_ar0234", "rearleft", ZEDX_DEVNAME_LEFT3, ZEDX_PROC_LEFT3)
					ZEDX_CAMERA_MODULE(10, "zedx_right3_ar0234", "rearright", ZEDX_DEVNAME_RIGHT3, ZEDX_PROC_RIGHT3)
					ZEDX_CAMERA_MODULE(11, "zedxone_gs3_ar0234", "rear", ZEDX_DEVNAME_ONE_GS3, ZEDX_PROC_ONE_GS3)
					ZEDX_CAMERA_MODULE(12, "zedx_left4_ar0234", "frontleft", ZEDX_DEVNAME_LEFT4, ZEDX_PROC_LEFT4)
					ZEDX_CAMERA_MODULE(13, "zedx_right4_ar0234", "frontright", ZEDX_DEVNAME_RIGHT4, ZEDX_PROC_RIGHT4)
					ZEDX_CAMERA_MODULE(14, "zedxone_gs4_ar0234", "front", ZEDX_DEVNAME_ONE_GS4, ZEDX_PROC_ONE_GS4)
					ZEDX_CAMERA_MODULE(15, "zedx_left5_ar0234", "frontleft", ZEDX_DEVNAME_LEFT5, ZEDX_PROC_LEFT5)
					ZEDX_CAMERA_MODULE(16, "zedx_right5_ar0234", "frontright", ZEDX_DEVNAME_RIGHT5, ZEDX_PROC_RIGHT5)
					ZEDX_CAMERA_MODULE(17, "zedxone_gs5_ar0234", "front", ZEDX_DEVNAME_ONE_GS5, ZEDX_PROC_ONE_GS5)
					ZEDX_CAMERA_MODULE(18, "zedx_left6_ar0234", "rearleft", ZEDX_DEVNAME_LEFT6, ZEDX_PROC_LEFT6)
					ZEDX_CAMERA_MODULE(19, "zedx_right6_ar0234", "rearright", ZEDX_DEVNAME_RIGHT6, ZEDX_PROC_RIGHT6)
					ZEDX_CAMERA_MODULE(20, "zedxone_gs6_ar0234", "rear", ZEDX_DEVNAME_ONE_GS6, ZEDX_PROC_ONE_GS6)
					ZEDX_CAMERA_MODULE(21, "zedx_left7_ar0234", "rearleft", ZEDX_DEVNAME_LEFT7, ZEDX_PROC_LEFT7)
					ZEDX_CAMERA_MODULE(22, "zedx_right7_ar0234", "rearright", ZEDX_DEVNAME_RIGHT7, ZEDX_PROC_RIGHT7)
					ZEDX_CAMERA_MODULE(23, "zedxone_gs7_ar0234", "rear", ZEDX_DEVNAME_ONE_GS7, ZEDX_PROC_ONE_GS7)

				};
			};

			bus@0 {
				BOARD_GPIO_SETUP

				TEGRA_ZEDX_GMSL_I2C {
					#address-cells = <1>;
					#size-cells = <0>;

					max96712_a@29 {
						compatible = "stereolabs,sl_max96712";
						reg = <0x29>;
						channel = "a";
						pwr-gpio = ZEDX_DSER_PWR_GPIO;
						status = "okay";

						camera-serializers = <
							/* GMSL 0: ZED X (id=0) OR ZED X One GS (id=4) */
							&zedx_ser0
							&zedxone_gs_ser0
							/* GMSL 1: ZED X (id=1) OR ZED X One GS (id=5) */
							&zedx_ser1
							&zedxone_gs_ser1
							/* GMSL 2: ZED X (id=2) OR ZED X One GS (id=6) */
							&zedx_ser2
							&zedxone_gs_ser2
							/* GMSL 3: ZED X (id=3) OR ZED X One GS (id=7) */
							&zedx_ser3
							&zedxone_gs_ser3
						>;
					};

					bmi088_a: bmi088_a@3b {
						compatible = "bmi,bmi088";
						reg = <0x3b>;
						accel_i2c_addr = <0x3c>;
						accel_matrix = [01 00 00 00 01 00 00 00 01];
						gyro_matrix = [01 00 00 00 01 00 00 00 01];
					};

					bmi088_b: bmi088_b@4b {
