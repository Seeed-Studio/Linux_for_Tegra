	}; \
	mode3 { \
		mclk_khz = "24000"; \
		num_lanes = XSTR(LANES); \
		tegra_sinterface = OPT_CSI_SERIAL; \
		lane_polarity = LANE_POLARITY; \
		vc_id = VC_ID; \
		discontinuous_clk = "no"; \
		dpcm_enable = "false"; \
		cil_settletime = "0"; \
		dynamic_pixel_bit_depth = "10"; \
		csi_pixel_bit_depth = "10"; \
