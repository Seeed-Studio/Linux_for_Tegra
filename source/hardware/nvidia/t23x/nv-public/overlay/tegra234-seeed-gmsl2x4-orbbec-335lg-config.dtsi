/* 
 * #define CONFIG_RECOMPUTER_MINI_AGX_ORIN_J501X
 */
#define BOARD_GPIO_SETUP 
#define BOARD_GPIOS_SET 

#if defined(CONFIG_RECOMPUTER_MINI_AGX_ORIN_J501X)
    #warning "Using MINI-J501X camera GPIO configuration"
    /* reComputer Mini J501X Configuration */
    #define CAM0_RST_L      TEGRA234_MAIN_GPIO(Q, 6)
    #define CAM0_PWDN       TEGRA234_MAIN_GPIO(H, 6)
    #define CAM0_VDD        TEGRA234_AON_GPIO(CC, 0)

    #define CAM1_RST_L      TEGRA234_MAIN_GPIO(AC, 1)
    #define CAM1_PWDN       TEGRA234_MAIN_GPIO(AC, 0)
    #define CAM1_VDD        TEGRA234_AON_GPIO(BB, 2)

    #define SYNC_OUT        TEGRA234_MAIN_GPIO(R, 0)
    #define CAM2_PWDN       TEGRA234_MAIN_GPIO(A, 3)
    #define CAM3_PWDN       TEGRA234_AON_GPIO(CC, 1)
    #define PPS_TRIGGER     TEGRA234_AON_GPIO(CC, 2)

    #define TEGRA_GMSL_I2C_0 i2c@3190000
    #define TEGRA_GMSL_I2C_1 i2c@c250000

    #define BOARD_GPIO_SETUP \
        gpio@2200000 { \
            camera-control-output-high1 { \
                gpio-hog; \
                output-high; \
                gpios = <CAM0_RST_L 0 CAM1_RST_L 0 CAM2_PWDN 0>; \
                label = "cam0-rst", "cam1-rst", "cam2-pwdn"; \
            }; \
        }; \
        gpio@c2f0000 { \
            camera-control-output-high2 { \
                gpio-hog; \
                output-high; \
                gpios = <CAM0_VDD 0 CAM1_VDD 0 CAM3_PWDN 0>; \
                label = "cam0-vdd", "cam1-vdd", "cam3-pwdn"; \
            }; \
        };

#elif defined(CONFIG_RECOMPUTER_ROBO_AGX_ORIN_J501X)
    #warning "Using ROBO-J501X camera GPIO configuration"
    /* reComputer Robo AGX Orin J501X Configuration */
    #define CAM0_RST_L      TEGRA234_MAIN_GPIO(H, 3)
    #define CAM0_PWDN       TEGRA234_MAIN_GPIO(H, 6)
    
    #define CAM1_RST_L      TEGRA234_MAIN_GPIO(AC, 1)
    #define CAM1_PWDN       TEGRA234_MAIN_GPIO(AC, 0)
    
    #define SYNC_OUT        TEGRA234_MAIN_GPIO(R, 0)
    #define CAM2_PWDN       TEGRA234_MAIN_GPIO(A, 3)
    #define CAM3_PWDN       TEGRA234_MAIN_GPIO(H, 4)
    #define PPS_TRIGGER     TEGRA234_AON_GPIO(CC, 2)

    #define TEGRA_GMSL_I2C_0 i2c@3190000
    #define TEGRA_GMSL_I2C_1 i2c@c250000

    #define BOARD_GPIO_SETUP \
        gpio@2200000 { \
            camera-control-output-high1 { \
                gpio-hog; \
                output-high; \
                gpios = <CAM0_RST_L 0 CAM0_PWDN 0 CAM1_RST_L 0 CAM1_PWDN 0 CAM2_PWDN 0 CAM3_PWDN 0>; \
                label = "cam0-rst", "cam0-pwdn", "cam1-rst", "cam1-pwdn", "cam2-pwdn", "cam3-pwdn"; \
            }; \
        };

    #define BOARD_GPIOS_SET \
        cam0_vdd { \
            compatible = "regulator-fixed"; \
            regulator-name = "cam0-vdd"; \
            gpio = <&gpio_xten 14 0>; \
            enable-active-high; \
            regulator-boot-on; \
            regulator-always-on; \
        }; \
        cam1_vdd { \
            compatible = "regulator-fixed"; \
            regulator-name = "cam1-vdd"; \
            gpio = <&gpio_xten 5 0>; \
            enable-active-high; \
            regulator-boot-on; \
            regulator-always-on; \
        };

#else
    /* Default Configuration (e.g. AGX Orin Devkit) */
    #warning "Using DEFAULT configuration for camera GPIO setup"
    #define CAM0_RST_L      TEGRA234_MAIN_GPIO(Q, 6)
    #define CAM0_PWDN       TEGRA234_MAIN_GPIO(H, 6)
    #define CAM0_VDD        TEGRA234_AON_GPIO(CC, 0)

    #define CAM1_RST_L      TEGRA234_MAIN_GPIO(AC, 1)
    #define CAM1_PWDN       TEGRA234_MAIN_GPIO(AC, 0)
    #define CAM1_VDD        TEGRA234_AON_GPIO(BB, 2)

    #define SYNC_OUT        TEGRA234_MAIN_GPIO(R, 0)
    #define CAM2_PWDN       TEGRA234_MAIN_GPIO(A, 3)
    #define CAM3_PWDN       TEGRA234_AON_GPIO(CC, 1)
    #define PPS_TRIGGER     TEGRA234_AON_GPIO(CC, 2)

    #define TEGRA_GMSL_I2C_0 i2c@3190000
    #define TEGRA_GMSL_I2C_1 i2c@c250000

    #define BOARD_GPIO_SETUP \
        gpio@2200000 { \
            camera-control-output-high1 { \
                gpio-hog; \
                output-high; \
                gpios = <CAM0_RST_L 0 CAM1_RST_L 0 CAM2_PWDN 0>; \
                label = "cam0-rst", "cam1-rst", "cam2-pwdn"; \
            }; \
        }; \
        gpio@c2f0000 { \
            camera-control-output-high2 { \
                gpio-hog; \
                output-high; \
                gpios = <CAM0_VDD 0 CAM1_VDD 0 CAM3_PWDN 0>; \
                label = "cam0-vdd", "cam1-vdd", "cam3-pwdn"; \
            }; \
        };

#endif
