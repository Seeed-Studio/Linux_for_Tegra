# SPDX-License-Identifier: GPL-2.0-only
#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i -c --exclude-per-directory=.gitignore'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules (sorted alphabetically)
#
.*
*.a
*.asn1.[ch]
*.bin
*.bz2
*.c.[012]*.*
*.dt.yaml
*.dtb
*.dtbo
*.dtb.S
*.dtbo.S
*.dwo
*.elf
*.gcno
*.gz
*.i
*.ko
*.lex.c
*.ll
*.lst
*.lz4
*.lzma
*.lzo
*.mod
*.mod.c
*.o
*.o.*
*.patch
*.rmeta
*.rpm
*.rsi
*.s
*.so
*.so.dbg
*.su
*.symtypes
*.symversions
*.tab.[ch]
*.tar
*.xz
*.zst
kernel/kernel-5.10/Module.symvers
kernel/kernel-5.10/dtbs-list
kernel/kernel-5.10/modules.order

#
# Top-level generic files
#
kernel/kernel-5.10/linux
kernel/kernel-5.10/modules-only.symvers
kernel/kernel-5.10/vmlinux
kernel/kernel-5.10/vmlinux.32
kernel/kernel-5.10/vmlinux.map
kernel/kernel-5.10/vmlinux.symvers
kernel/kernel-5.10/vmlinux-gdb.py
kernel/kernel-5.10/vmlinuz
kernel/kernel-5.10/System.map
kernel/kernel-5.10/Module.markers
kernel/kernel-5.10/modules.builtin
kernel/kernel-5.10/modules.builtin.modinfo
kernel/kernel-5.10/modules.nsdeps

#
# RPM spec file (make rpm-pkg)
#
kernel/kernel-5.10/rpmbuild/

#
# Debian directory (make deb-pkg)
#
kernel/kernel-5.10/debian/

#
# Snap directory (make snap-pkg)
#
kernel/kernel-5.10/snap/

#
# tar directory (make tar*-pkg)
#
kernel/kernel-5.10/tar-install/

#
# We don't want to ignore the following even if they are dot-files
#
!.clang-format
!.cocciconfig
!.editorconfig
!.get_maintainer.ignore
!.gitattributes
!.gitignore
!.kunitconfig
!.mailmap
!.rustfmt.toml

#
# Generated include files
#
kernel/kernel-5.10/include/config/
kernel/kernel-5.10/include/generated/
kernel/kernel-5.10/arch/*/include/generated/

# stgit generated dirs
patches-*

# quilt's files
patches
series

# ctags files
tags
TAGS

# cscope files
cscope.*
ncscope.*

# gnu global files
GPATH
GRTAGS
GSYMS
GTAGS

# id-utils files
ID

*.orig
*~
\#*#

#
# Leavings from module signing
#
extra_certificates
signing_key.pem
signing_key.priv
signing_key.x509
x509.genkey

# Kconfig presets
kernel/kernel-5.10/all.config
kernel/kernel-5.10/alldef.config
kernel/kernel-5.10/allmod.config
kernel/kernel-5.10/allno.config
kernel/kernel-5.10/allrandom.config
kernel/kernel-5.10/allyes.config

# Kconfig savedefconfig output
kernel/kernel-5.10/defconfig

# Kdevelop4
*.kdev4

# Clang's compilation database file
kernel/kernel-5.10/compile_commands.json

# Documentation toolchain
sphinx_*/

# Rust analyzer configuration
kernel/kernel-5.10/rust-project.json
