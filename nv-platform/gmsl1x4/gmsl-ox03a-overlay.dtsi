#if defined(DES_CH_INDEX)
#define DES_CH_SECOND_INDEX CONCAT(1, DES_CH_INDEX)
#endif

#if defined(SER_INDEX)
#define SER_LABEL CONCAT(ser_, SER_INDEX)
#endif

#if !defined(SER_LABEL)
#error
#endif

#define SER_MFP0_PWDN_LABEL CONCAT(SER_LABEL, _mfp0_pwdn)
#define SER_MFP7_FSYNC_LABEL CONCAT(SER_LABEL, _mfp7_fsync)
// #define SER_MFP10_RESET_LABEL CONCAT(SER_LABEL, _mfp10_reset)


&SER_LABEL {
	pipe@0 {
		maxim,dbl8;
		maxim,soft-bpp = <16>;
	};

	pins {


		SER_MFP0_PWDN_LABEL: SER_MFP0_PWDN_LABEL {
			pins = "mfp0";
			function = "gpio";
			output-high;
			output-enable;
		};



		// SER_MFP2_FSYNC_LABEL: SER_MFP2_FSYNC_LABEL {
		// 	pins = "mfp2";
		// 	function = "gpio";
		// 	output-high;
		// 	input-disable;
		// };

		SER_MFP7_FSYNC_LABEL: SER_MFP7_FSYNC_LABEL {
			pins = "mfp7";
			function = "gpio";
			output-high;
			input-disable;
		};


		// SER_MFP9_PWDN_LABEL: SER_MFP9_PWDN_LABEL {
		// 	pins = "mfp9";
		// 	function = "gpio";
		// 	output-high;
		// 	output-enable;
		// };

		// SER_MFP10_RESET_LABEL: SER_MFP10_RESET_LABEL {
		// 	pins = "mfp10";
		// 	function = "gpio";
		// 	output-high;
		// 	input-disable;
		// };


		// SER_MFP4_RCLK_LABEL: SER_MFP4_RCLK_LABEL {
		// 	pins = "mfp4";
		// 	function = "rclkout";
		// 	slew-rate = <0>;
		// 	maxim,rclkout-clock = <0>;
		// };
	};
};

&des {
	phy@GMSL_DES_PHY {
		maxim,alt-mem-map8;
	};
};

#undef SER_MFP9_PWDN_LABEL
#undef SER_MFP2_FSYNC_LABEL
#undef SER_MFP10_RESET_LABEL

#undef SER_INDEX
#undef SER_LABEL
#undef DES_CH_INDEX
