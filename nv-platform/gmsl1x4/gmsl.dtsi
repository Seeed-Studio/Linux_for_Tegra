&des {
	phy@GMSL_DES_PHY {
		reg = <GMSL_DES_PHY>;
	};



	pipe@0 {
		reg = <0x00>;
		maxim,phy-id = <GMSL_DES_PHY>;
		maxim,stream-id = <0x00>;
		maxim,link-id = <0x00>;
	};
	pipe@1 {
		reg = <0x01>;
		maxim,phy-id = <GMSL_DES_PHY>;
		maxim,stream-id = <0x01>;
		maxim,link-id = <0x01>;
	};
	pipe@2 {
		reg = <0x02>;
		maxim,phy-id = <GMSL_DES_PHY>;
		maxim,stream-id = <0x02>;
		maxim,link-id = <0x02>;
	};
	pipe@3 {
		reg = <0x03>;
		maxim,phy-id = <GMSL_DES_PHY>;
		maxim,stream-id = <0x03>;
		maxim,link-id = <0x03>;
	};

