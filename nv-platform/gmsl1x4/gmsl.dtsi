&GMSL_DES_I2C_LABEL {
	status = "okay";
	des: gmsl-deserializer@GMSL_DES_HEX_ADDR {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = GMSL_DES_COMPATIBLE;
		reset-gpios = <&gpio TEGRA234_MAIN_GPIO(H, 6) GPIO_ACTIVE_HIGH>;
		reg = <GMSL_DES_HEX_ADDR>;
		status = "okay";
#if defined(GMSL_MODE_3G)
		maxim,speed-mode = <0x00>;
#elif defined(GMSL_MODE_6G)
		maxim,speed-mode = <0x01>;
#else
	#error "please define gmsl2 mode"
#endif
	};

};



&des {
	i2c-alias-pool = <
#if defined(GMSL_CAMERA_0)
		GMSL_SER_0_HEX_ADDR
#endif
#if defined(GMSL_CAMERA_1)
		GMSL_SER_1_HEX_ADDR
#endif
#if defined(GMSL_CAMERA_2)
		GMSL_SER_2_HEX_ADDR
#endif
#if defined(GMSL_CAMERA_3)
		GMSL_SER_3_HEX_ADDR
#endif
	>;

	i2c-atr {
		#address-cells = <1>;
		#size-cells = <0>;

#if defined(GMSL_CAMERA_0)
		des_i2c_0: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;

			reg = <0>;
		};
#endif

#if defined(GMSL_CAMERA_1)
		des_i2c_1: i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;

			reg = <1>;
		};
#endif

#if defined(GMSL_CAMERA_2)
		des_i2c_2: i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;

			reg = <2>;
		};
#endif

#if defined(GMSL_CAMERA_3)
		des_i2c_3: i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;

			reg = <3>;
		};
#endif
	};
};

