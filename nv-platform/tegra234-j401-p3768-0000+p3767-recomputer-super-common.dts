/dts-v1/;

#include "tegra234-super-j401-p3768-0000+p3767-0000.dts"
#include "tegra234-p3768-0000+p3767-xxxx-nv-common.dtsi"
#include <dt-bindings/tegra234-p3767-0000-common.h>

/ {
        bus@0 {
                i2c@3160000 {
                        #address-cells = <1>;
                        #size-cells = <0>;

                        eeprom@57 {
                                compatible = "atmel,24c02";
                                reg = <0x57>;
                                /*16 bit*/
                                address-width = <0x08>;
                                /*32768 bytes */
                                size = <0x100>;
				/delete-property/ read-only;
                        };
                };
        };
};
