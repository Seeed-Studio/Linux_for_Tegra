		l2c_0: l2-cache-0 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <1048576>;
			cache-line-size = <64>;
			cache-sets = <2048>;
			cache-unified;
		};

		l2c_1: l2-cache-1 {
			compatible = "cache";
			cache-level = <2>;
