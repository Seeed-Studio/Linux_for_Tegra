	        idle-states {
	            cc7: cc7 {
	                compatible = "arm,idle-state";
	                state-name = "Cluster Powergate";
	                entry-latency-us = <5000>;
			exit-latency-us = <5000>;
			min-residency-us = <25000>;
			arm,psci-suspend-param= <0x40000007>;
			status = "disabled";
	            };
	        };

	        domain-idle-states {
			cr7: cr7 {
				compatible = "domain-idle-state";
				state-name = "SoC Railgate";
				entry-latency-us = <0xFFFFFFFF>;
				exit-latency-us = <0xFFFFFFFF>;
				min-residency-us = <0xFFFFFFFF>;
				arm,psci-suspend-param= <0x40000008>;
				status = "disabled";
			};
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu_0>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu_1>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu_2>;
				};
			};

			cluster3 {
