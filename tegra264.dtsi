			#mbox-cells = <2>;
			interrupt-names = "shared1", "shared2", "shared3", "shared4";
		};

		rce_hsp1: tegra-hsp@8189200000 {
			compatible = "nvidia,tegra264-hsp",
				     "nvidia,tegra234-hsp",
				     "nvidia,tegra186-hsp";
			status = "disabled";

			reg = <0x81 0x89200000 0x0 0xc0000>;
			interrupts =	<GIC_SPI 419 IRQ_TYPE_LEVEL_HIGH>,
