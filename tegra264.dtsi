	cpus {
		#address-cells = <2>;
	        #size-cells = <2>;

		cpu_0: cpu@0 {
			compatible = "arm,armv8",
				     "arm,cortex-a78";
			status = "disabled";

			device_type = "cpu";
			reg = <0x0 0x0>;

			enable-method = "psci";
			power-domains = <&cluster_pd0>;
			power-domain-names = "psci";
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2c_0>;
		};

		cpu_1: cpu@1 {
			compatible = "arm,armv8",
