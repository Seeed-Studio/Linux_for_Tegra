#<ROOTFS_B>#<EXTERNAL>Update_B2:Write_APP_b:nvme:APP_b:R35-ToT/flash.idx

# Switch to the default boot mode
Update_B2:Write:sdmmc_user:bootloader-dtb:R35-ToT/flash.idx
Update_B2:Write:sdmmc_user:cpu-bootloader:R35-ToT/flash.idx
Update_B2:Clean:sdmmc_user:uefi_variables:R35-ToT/flash.idx
Update_B2:Write:sdmmc_user:esp:R35-ToT/flash.idx
