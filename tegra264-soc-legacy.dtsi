				clock-names = "se";
				iommus = <0x0000003e 0x00001802>;
				dma-coherent;
				status = "disabled";
			};
			se@8188110000 {
				compatible = "nvidia,tegra264-se1-sm4";
				reg = <0x00000081 0x88110000 0x00000000 0x00010000>;
