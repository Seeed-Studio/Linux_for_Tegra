					iommus = <&smmu4_mmu 0x00001101>;
					dma-coherent;
					status = "disabled";
				};
			};
			se@8188140000 {
				compatible = "nvidia,tegra264-se4-hash";
				reg = <0x00000081 0x88140000 0x00000000 0x00010000>;
				clocks = <&bpmp 0x00000025>;
				clock-names = "se";
