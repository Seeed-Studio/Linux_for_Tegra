			iommus = <&smmu3_mmu 0x00000901>;
			dma-coherent;
			status = "disabled";
		};
	};

	dce@8808000000 {
		compatible = "nvidia,tegra264-dce";
		reg = <0x00000088 0x08000000 0x00000000 0x00800000>;
		interrupts = <0x00000000 0x000000ee 0x00000004 0x00000000 0x000000ef 0x00000004 0x00000000 0x000000f0 0x00000004 0x00000000 0x000000f1 0x00000004>;
		interrupt-names = "dce-smb-0", "dce-smb-1", "dce-smb-2", "dce-smb-3";
		status = "disabled";
		numa-node-id = <0x00000000>;
		sha-carveout {
			compatible = "sha-carveout";
			status = "disabled";
		};
	};

	fsicom_client: fsicom_client {
		compatible = "nvidia,tegra234-fsicom-client";
		mboxes = <&top_hsp2 0x00000101 0x80000002 &top_hsp2 0x00000101 0x00000001 &top_hsp2 0x00000101 0x80000005 &top_hsp2 0x00000101 0x00000004>;
		mbox-names = "fsi-tx-cpu0", "fsi-rx-cpu0", "fsi-tx-cpu1", "fsi-rx-cpu1";
		iommus = <&smmu4_mmu 0x00000f10>;
		memory-region = <&reservation_fsicom>;
		dma-coherent;
		smmu_inst = <0x00000000>;
		max_fsi_core = <0x00000001>;
		status = "disabled";
	};

        fsicom_client_inst1: fsicom_client_inst1 {
                compatible = "nvidia,tegra234-fsicom-client";
                iommus = <&smmu4_mmu 0x00000f11>;
                memory-region = <&fsicom_resv_inst1>;
                dma-coherent;
                smmu_inst = <1>;
                status = "disabled";
        };
};
