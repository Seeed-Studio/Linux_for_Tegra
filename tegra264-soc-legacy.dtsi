				reset-names = "pva0";
				clocks = <&bpmp 0x00000017 &bpmp 0x00000013 &bpmp 0x00000018>;
				clock-names = "axi", "vps0", "vps1";
				iommus = <&smmu4_mmu 0x00001100>;
				dma-coherent;
				status = "disabled";
				pva0_niso1_ctx0 {
					compatible = "nvidia,pva-tegra186-iommu-context";
					iommus = <&smmu4_mmu 0x00001102>;
					dma-coherent;
					status = "disabled";
				};
				pva0_niso1_ctx1 {
