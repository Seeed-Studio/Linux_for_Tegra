/ {
	reserved-memory {
		gpu0_reserved: gpu0_carveout {
			compatible = "nvidia,gpu0_carveout";
			size = <0x00000000 0x60000000>;
			alignment = <0x00000000 0x00200000>;
			no-map;
			granule-size = <0x00200000>;
			status = "disabled";
		};
		gpu1_reserved: gpu1_carveout {
			compatible = "nvidia,gpu1_carveout";
			no-map;
			granule-size = <0x200000>;
			status = "disabled";
		};
		rce_resv: rce-reservation {
			iommu-addresses = <&rce_misc 0x00000000 0x00000000 0x00000000 0x10000000 &rce_misc 0x00000000 0x20000000 0xffffffff 0x3fffffff>;
		};
		adsp0_resv: reservation-adsp0 {
			iommu-addresses = <&adsp 0x00000000 0x00000000 0x00000000 0x20000000 &adsp 0x00000000 0x40000000 0xffffffff 0xffffffff>;
		};
		adsp1_resv: reservation-adsp1 {
			iommu-addresses = <&adsp1 0x00000000 0x00000000 0x00000000 0x20000000 &adsp1 0x00000000 0x40000000 0xffffffff 0xffffffff>;
		};
		reservation_fsicom: reservation-fsicom {
			iommu-addresses = <&fsicom_client 0x00000000 0x00000000 0x00000000 0xf0000000 &fsicom_client 0x00000000 0xf1000000 0xffffffff 0x0effffff>;
		};
		fsicom_resv_inst1: reservation-fsicom_inst1 {
			iommu-addresses = <&fsicom_client_inst1 0x00000000 0x00000000 0x00000000 0xf0000000 &fsicom_client_inst1 0x00000000 0xf1000000 0xffffffff 0x0effffff>;
		};
		sec-mon {
			reg = <0x00000000 0x84080000 0x00000000 0x00400000>;
		};
		camdbg_reserved: camdbg_carveout {
			 compatible = "nvidia,camdbg_carveout";
			 size = <0 0x6400000>;
			 alignment = <0 0x100000>;
			 alloc-ranges = <0x1 0 0x1 0>;
			 status = "disabled";
		 };
	};

	sound {
		clocks = <&bpmp 0x0000009d &bpmp 0x000000a2>;
		clock-names = "pll_a", "plla_out0";
		assigned-clocks = <&bpmp 0x0000009d &bpmp 0x000000a2 &bpmp 0x00000115>;
		assigned-clock-parents = <0x00000000 &bpmp 0x0000009d &bpmp 0x000000a2>;
		status = "disabled";
	};

	tegra-carveouts {
		compatible = "nvidia,carveouts-t19x";
		memory-region = <&vpr &gpu0_reserved &gpu1_reserved &fsi_reserved &vpr1>;
		status = "disabled";
	};

	tegra_ist {
		compatible = "nvidia,tegra26x-ist";
		status = "disabled";
	};

	smmu_test {
		compatible = "nvidia,smmu_test";
		iommus = <&smmu4_mmu 0x00000000>;
		status = "disabled";
	};

	bus@0 {
		memory-controller-hwpm@8108020000 {
			compatible = "nvidia,tegra-t264-mc-hwpm";
			reg = <0x00000081 0x08020000 0x00000000 0x00020000 0x00000081 0x08040000 0x00000000 0x00020000 0x00000081 0x08060000 0x00000000 0x00020000 0x00000081 0x08080000 0x00000000 0x00020000 0x00000081 0x080a0000 0x00000000 0x00020000 0x00000081 0x080c0000 0x00000000 0x00020000 0x00000081 0x080e0000 0x00000000 0x00020000 0x00000081 0x08100000 0x00000000 0x00020000 0x00000081 0x08120000 0x00000000 0x00020000 0x00000081 0x08140000 0x00000000 0x00020000 0x00000081 0x08160000 0x00000000 0x00020000 0x00000081 0x08180000 0x00000000 0x00020000 0x00000081 0x081a0000 0x00000000 0x00020000 0x00000081 0x081c0000 0x00000000 0x00020000 0x00000081 0x081e0000 0x00000000 0x00020000 0x00000081 0x08200000 0x00000000 0x00020000 0x00000081 0x08220000 0x00000000 0x00020000>;
			status = "disabled";
		};
		memory-controller-err@8108020000 {
			compatible = "nvidia,tegra-t264-mc-err";
			reg = <0x00000081 0x08020000 0x00000000 0x00020000 0x00000081 0x08040000 0x00000000 0x00020000 0x00000081 0x08060000 0x00000000 0x00020000 0x00000081 0x08080000 0x00000000 0x00020000 0x00000081 0x080a0000 0x00000000 0x00020000 0x00000081 0x080c0000 0x00000000 0x00020000 0x00000081 0x080e0000 0x00000000 0x00020000 0x00000081 0x08100000 0x00000000 0x00020000 0x00000081 0x08120000 0x00000000 0x00020000 0x00000081 0x08140000 0x00000000 0x00020000 0x00000081 0x08160000 0x00000000 0x00020000 0x00000081 0x08180000 0x00000000 0x00020000 0x00000081 0x081a0000 0x00000000 0x00020000 0x00000081 0x081c0000 0x00000000 0x00020000 0x00000081 0x081e0000 0x00000000 0x00020000 0x00000081 0x08200000 0x00000000 0x00020000 0x00000081 0x08220000 0x00000000 0x00020000>;
			interrupts = <0x00000000 0x0000008b 0x00000004>;
			status = "disabled";
		};
		pcie@810c000000 {
			nvidia,host1x = <&host1x>;
		};

		host1x@8181200000 {
			pva0@818c000000 {
				compatible = "nvidia,tegra264-pva", "simple-bus";
				reg = <0x00000081 0x8c000000 0x00000000 0x00900000 0x00000000 0x10700000 0x00000000 0x00100000>;
				interrupts = <0x00000000 0x00000195 0x00000004 0x00000000 0x00000196 0x00000004 0x00000000 0x00000197 0x00000004 0x00000000 0x00000198 0x00000004 0x00000000 0x00000199 0x00000004 0x00000000 0x0000019a 0x00000004 0x00000000 0x0000019b 0x00000004 0x00000000 0x0000019c 0x00000004 0x00000000 0x0000019d 0x00000004>;
