                        va = <0x0 0xa101f000>;
                        physical = <0x1>;
                        /* Update this to point to the streamid to be used. */
                        vm_index = <0x0>;
                        aperture_id = <0x0>;
                        snoop = <0x0>;
                        pa = <0x81 0x0101f000>;
