                        carveout = <0x0>;
                        va = <0x0 0xE0210000>;
                        physical = <0x1>;
                        /* Update this to point to the streamid to be used. */
                        vm_index = <0x0>;
                        aperture_id = <0x0>;
                        snoop = <0x0>;
                        pa = <0xA8 0x00210000>;
                        size = <0x0B6BFFFF>;
                    };
                    ast_region@7 {
