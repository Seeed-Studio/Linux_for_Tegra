                        carveout = <0x0>;
                        va = <0x0 0xb8210000>;
                        physical = <0x1>;
                        /* Update this to point to the streamid to be used. */
                        vm_index = <0x0>;
                        aperture_id = <0x0>;
                        snoop = <0x0>;
                        pa = <0x81 0x80210000>;
                        size = <0x03E2FFFF>;
                    };
                    ast_region@5 {
                        enable = <0x1>;
