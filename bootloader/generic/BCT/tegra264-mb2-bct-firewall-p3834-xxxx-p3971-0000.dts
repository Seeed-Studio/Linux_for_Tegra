            exclusion-info = <20>;
            value = <0x80000002>;
        };

        reg@14366 { /* FSI_FABRIC, FSI_CONTROL_FIREWALL_FSI_CAN1_BLF, CTL_SETTING */
            exclusion-info = <20>;
            value = <0x80030002>;
        };

        reg@14367 { /* FSI_FABRIC, FSI_CONTROL_FIREWALL_FSI_CAN2_BLF, READ_CTL_0 */
            exclusion-info = <20>;
            value = <0x80000002>;
        };

