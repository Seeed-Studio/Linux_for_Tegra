            exclusion-info = <20>;
            value = <0x80000002>;
        };

        reg@14371 { /* FSI_FABRIC, FSI_CONTROL_FIREWALL_FSI_CAN2_BLF, CTL_SETTING */
            exclusion-info = <20>;
            value = <0x80030002>;
        };

        reg@14372 { /* FSI_FABRIC, FSI_CONTROL_FIREWALL_FSI_CAN3_BLF, READ_CTL_0 */
            exclusion-info = <20>;
            value = <0x80000002>;
        };

        reg@14374 { /* FSI_FABRIC, FSI_CONTROL_FIREWALL_FSI_CAN3_BLF, WRITE_CTL_0 */
