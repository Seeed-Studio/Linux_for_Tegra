function rcmdump_get_eeprom ()
{
    local ret=0;
    local _chipid="${1}";

    if [ -d rcmdump_blob ]; then
        pushd rcmdump_blob > /dev/null 2>&1 || exit;
        if bash rcmdumpcmd.txt; then
            ./tegrarcm_v2 --chip "${_chipid}" 0 --oem platformdetails eeprom cvm cvm.bin;
            if [ -f cvm.bin ]; then
                echo "Successfully retrieved eeprom."
            else
                echo "Failed to retrieve eeprom.";
                ret=1;
            fi;
        else
            echo "Failed to execute rcmdumpcmd.txt.";
            ret=2;
        fi;
        if [ ${ret} != 2 ]; then
            echo "Setting target to recovery mode";
            ./tegrarcm_v2 --chip "${_chipid}" 0 --reboot recovery;
            sleep 1;
        fi;
        popd > /dev/null 2>&1 || exit;
        if [ ${ret} = 0 ]; then
            cp rcmdump_blob/cvm.bin cvm.bin;
        fi;
        rm -rf rcmdump_blob;
    else
        echo "Warning: No rcmdump_blob.";
    fi;
    return ${ret};
};

function read_eeprom ()
{
    if rcmdump_get_eeprom "${1}"; then
        echo "";
        echo "eeprom content:";
        echo "===============";
        xxd -g 1 cvm.bin;
        echo "===============";
    fi
}
