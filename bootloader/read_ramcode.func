function rcmdump_get_ramcode ()
{
    local ret=0;
    local _chipid="${1}";

    if [ -f rcmdump_blob.tar ]; then
        tar -xf rcmdump_blob.tar
        pushd rcmdump_blob > /dev/null 2>&1 || exit;
        if bash rcmdumpcmd.txt; then
            ./tegrarcm_v2 --chip "${_chipid}" 0 --oem platformdetails chip chipinfo.bin;
            if ! boardRamcode=$(./chkbdinfo -R chipinfo.bin); then
                echo "Failed to get on-board ramcode.";
                ret=1;
            fi;
        else
            echo "Failed to execute rcmdumpcmd.txt.";
            ret=2;
        fi;
        if [ ${ret} = 0 ]; then
            boardRamcode="$(echo "${boardRamcode}" | cut -d: -f 4)";
            boardRamcode="$((16#${boardRamcode} % 16))";
            echo "The on-board ramcode=${boardRamcode}";
        else
            boardRamcode="";
        fi;
        if [ ${ret} != 2 ]; then
            echo "Setting target to recovery mode";
            ./tegrarcm_v2 --chip "${_chipid}" 0 --reboot recovery;
            sleep 1;
        fi;
        popd > /dev/null 2>&1 || exit;
        rm -rf rcmdump_blob;
    else
        echo "Warning: No rcmdump_blob.";
    fi;
    return ${ret};
};

boardRamcode="";

function read_ramcode ()
{
    rcmdump_get_ramcode "${1}";
    echo "on-board ramcode=${boardRamcode}";

    if [ "${boardRamcode}" != "" ]; then
         ramcode=${boardRamcode};
    fi;

    echo "Use ramcode=${ramcode}";
}

function t234_set_ramcode_mem_bct ()
{
    ram_group=$((ramcode / 4));
    echo "ram_group=${ram_group}";

    src_mem_rcm_file=${mem_rcm_file/mem_rcm_/mem_rcm_${ram_group}_}

    echo "copying ${src_mem_rcm_file} to ${mem_rcm_file}";
    cp "${src_mem_rcm_file}" "${mem_rcm_file}";
}

function t264_get_ramcode_mem_bct ()
{
    ram_group=$((ramcode / 2));
    echo "ram_group=${ram_group}";

    rc_mem_rcm_file=${mem_rcm_file/membct_?_/membct_${ram_group}_}
    echo "rc_mem_rcm_file=${rc_mem_rcm_file}"
    eval "${1}=${rc_mem_rcm_file}"
}

