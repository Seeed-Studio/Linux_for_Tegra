/*
 * Board-level configuration for tegra234-stereolabs-zedx-overlay.dts.
 *
 * Add future boards here with a new CONFIG_* block and keep camera topology in
 * the shared overlay unless the GMSL camera layout itself changes.
 */

#if !defined(CONFIG_RECOMPUTER_ROBO_AGX_ORIN_J501X)
#define CONFIG_RECOMPUTER_ROBO_AGX_ORIN_J501X
#endif

#if defined(CONFIG_RECOMPUTER_ROBO_AGX_ORIN_J501X)

#define ZEDX_OVERLAY_NAME	"Stereolabs ZED X for reComputer J501 Robo"

#define CAM0_RST_L		TEGRA234_MAIN_GPIO(H, 3)
#define CAM0_PWDN		TEGRA234_MAIN_GPIO(H, 6)
#define CAM0_VDD		14

/* 2nd MAX96712 deserializer (channel "b") on i2c@c250000 (J23 connector) */
#define CAM1_RST_L		TEGRA234_MAIN_GPIO(AC, 1)
#define CAM1_PWDN		TEGRA234_MAIN_GPIO(AC, 0)
#define CAM1_VDD		5

#define TEGRA_ZEDX_GMSL_I2C	i2c@3190000
#define TEGRA_ZEDX_GMSL_I2C_1	i2c@c250000
#define ZEDX_DSER_PWR_GPIO	<&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>
#define ZEDX_DSER_B_PWR_GPIO	<&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>

/*
 * Platform module devname/proc macros.
 *
 * Bus index "3" for i2c@3190000 is stable. Bus index "7" for i2c@c250000
 * must be verified at runtime via `i2cdetect -l`; update if different.
 */

/* MAX96712_a (channel "a", bus 3, J22 connector, port-index 0-3) */
#define ZEDX_DEVNAME_LEFT0	"zedx 3-0028"
#define ZEDX_DEVNAME_RIGHT0	"zedx 3-0020"
#define ZEDX_DEVNAME_LEFT1	"zedx 3-0038"
#define ZEDX_DEVNAME_RIGHT1	"zedx 3-0030"
#define ZEDX_DEVNAME_LEFT2	"zedx 3-0048"
#define ZEDX_DEVNAME_RIGHT2	"zedx 3-0040"
#define ZEDX_DEVNAME_LEFT3	"zedx 3-0014"
#define ZEDX_DEVNAME_RIGHT3	"zedx 3-0041"
#define ZEDX_DEVNAME_ONE_GS0	"zedx 3-0010"
#define ZEDX_DEVNAME_ONE_GS1	"zedx 3-0011"
#define ZEDX_DEVNAME_ONE_GS2	"zedx 3-0012"
#define ZEDX_DEVNAME_ONE_GS3	"zedx 3-0013"

#define ZEDX_PROC_LEFT0		"/proc/device-tree/bus@0/i2c@3190000/zedx_left_0@28"
#define ZEDX_PROC_RIGHT0	"/proc/device-tree/bus@0/i2c@3190000/zedx_right_0@20"
#define ZEDX_PROC_LEFT1		"/proc/device-tree/bus@0/i2c@3190000/zedx_left_1@38"
#define ZEDX_PROC_RIGHT1	"/proc/device-tree/bus@0/i2c@3190000/zedx_right_1@30"
#define ZEDX_PROC_LEFT2		"/proc/device-tree/bus@0/i2c@3190000/zedx_left_2@48"
#define ZEDX_PROC_RIGHT2	"/proc/device-tree/bus@0/i2c@3190000/zedx_right_2@40"
#define ZEDX_PROC_LEFT3		"/proc/device-tree/bus@0/i2c@3190000/zedx_left_3@14"
#define ZEDX_PROC_RIGHT3	"/proc/device-tree/bus@0/i2c@3190000/zedx_right_3@41"
#define ZEDX_PROC_ONE_GS0	"/proc/device-tree/bus@0/i2c@3190000/zedxone_gs_0@10"
#define ZEDX_PROC_ONE_GS1	"/proc/device-tree/bus@0/i2c@3190000/zedxone_gs_1@11"
#define ZEDX_PROC_ONE_GS2	"/proc/device-tree/bus@0/i2c@3190000/zedxone_gs_2@12"
#define ZEDX_PROC_ONE_GS3	"/proc/device-tree/bus@0/i2c@3190000/zedxone_gs_3@13"

/* MAX96712_b (channel "b", bus 7, J23 connector, port-index 4-7) */
#define ZEDX_DEVNAME_LEFT4	"zedx 7-0028"
#define ZEDX_DEVNAME_RIGHT4	"zedx 7-0020"
#define ZEDX_DEVNAME_LEFT5	"zedx 7-0038"
#define ZEDX_DEVNAME_RIGHT5	"zedx 7-0030"
#define ZEDX_DEVNAME_LEFT6	"zedx 7-0048"
#define ZEDX_DEVNAME_RIGHT6	"zedx 7-0040"
#define ZEDX_DEVNAME_LEFT7	"zedx 7-0014"
#define ZEDX_DEVNAME_RIGHT7	"zedx 7-0041"
#define ZEDX_DEVNAME_ONE_GS4	"zedx 7-0010"
#define ZEDX_DEVNAME_ONE_GS5	"zedx 7-0011"
#define ZEDX_DEVNAME_ONE_GS6	"zedx 7-0012"
#define ZEDX_DEVNAME_ONE_GS7	"zedx 7-0013"

#define ZEDX_PROC_LEFT4		"/proc/device-tree/bus@0/i2c@c250000/zedx_left_4@28"
#define ZEDX_PROC_RIGHT4	"/proc/device-tree/bus@0/i2c@c250000/zedx_right_4@20"
#define ZEDX_PROC_LEFT5		"/proc/device-tree/bus@0/i2c@c250000/zedx_left_5@38"
#define ZEDX_PROC_RIGHT5	"/proc/device-tree/bus@0/i2c@c250000/zedx_right_5@30"
#define ZEDX_PROC_LEFT6		"/proc/device-tree/bus@0/i2c@c250000/zedx_left_6@48"
#define ZEDX_PROC_RIGHT6	"/proc/device-tree/bus@0/i2c@c250000/zedx_right_6@40"
#define ZEDX_PROC_LEFT7		"/proc/device-tree/bus@0/i2c@c250000/zedx_left_7@14"
#define ZEDX_PROC_RIGHT7	"/proc/device-tree/bus@0/i2c@c250000/zedx_right_7@41"
#define ZEDX_PROC_ONE_GS4	"/proc/device-tree/bus@0/i2c@c250000/zedxone_gs_4@10"
#define ZEDX_PROC_ONE_GS5	"/proc/device-tree/bus@0/i2c@c250000/zedxone_gs_5@11"
#define ZEDX_PROC_ONE_GS6	"/proc/device-tree/bus@0/i2c@c250000/zedxone_gs_6@12"
#define ZEDX_PROC_ONE_GS7	"/proc/device-tree/bus@0/i2c@c250000/zedxone_gs_7@13"

#define BOARD_GPIO_SETUP \
	gpio@2200000 { \
		camera-control-output-high1 { \
			gpio-hog; \
			output-high; \
			gpios = <CAM0_RST_L 0 CAM0_PWDN 0 CAM1_RST_L 0 CAM1_PWDN 0>; \
			label = "cam0-rst", "cam0-pwdn", "cam1-rst", "cam1-pwdn"; \
		}; \
	}; \
	i2c@3160000 { \
		gpio_xten@21 { \
			camera-vdd-output-high { \
				gpio-hog; \
				gpios = <CAM0_VDD GPIO_ACTIVE_HIGH CAM1_VDD GPIO_ACTIVE_HIGH>; \
				output-high; \
				line-name = "CAM0_VDD", "CAM1_VDD"; \
			}; \
		}; \
	};

#define BOARD_GPIOS_SET \
	cam0_vdd { \
		compatible = "regulator-fixed"; \
		regulator-name = "cam0-vdd"; \
		gpio = <&gpio_xten CAM0_VDD GPIO_ACTIVE_HIGH>; \
		enable-active-high; \
		regulator-boot-on; \
		regulator-always-on; \
	}; \
	cam1_vdd { \
		compatible = "regulator-fixed"; \
		regulator-name = "cam1-vdd"; \
		gpio = <&gpio_xten CAM1_VDD GPIO_ACTIVE_HIGH>; \
		enable-active-high; \
		regulator-boot-on; \
		regulator-always-on; \
	};

#else
#error "No board configuration selected for tegra234-stereolabs-zedx-overlay.dts"
#endif
