#include "tegra234-j401-stereolabs-zedx-config.dtsi"

#define NUM_LANES	2
#define NUM_LANES_A	4
#define NUM_LANES_B	4

#define STR(x) #x
#define XSTR(x) STR(x)

#define ZED_ORIN_CLKS \
	clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>, \
		<&bpmp TEGRA234_CLK_EXTPERIPH1>; \
	clock-names = "extperiph1", "pllp_grtba"; \
	mclk = "extperiph1";

