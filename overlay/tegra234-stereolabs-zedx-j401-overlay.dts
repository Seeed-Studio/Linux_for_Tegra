#define AR0234_MODES(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY) \
	AR0234_MODES_LANES_CLK(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY, NUM_LANES, "299000000")

#define AR0234_MODES_A(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY) \
	AR0234_MODES_LANES_CLK(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY, NUM_LANES_A, "598000000")

#define AR0234_MODES_B(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY) \
	AR0234_MODES_LANES_CLK(VC_ID, OPT_CSI_SERIAL, LANE_POLARITY, NUM_LANES_B, "598000000")

#define ZEDX_CAMERA_MODULE(ID, BADGE, POSITION, DEVNAME, PROC_DEV_TREE) \
	module##ID { \
		badge = BADGE; \
		position = POSITION; \
		orientation = "1"; \
		drivernode0 { \
			pcl_id = "v4l2_sensor"; \
			devname = DEVNAME; \
			proc-device-tree = PROC_DEV_TREE; \
		}; \
	};

#define ZEDX_VI_PORT(ID, REG_ID, VC_ID, VI_PORT_INDEX) \
	port@REG_ID { \
		reg = <REG_ID>; \
		zedx_vi_in##ID: endpoint { \
			vc-id = <VC_ID>; \
			port-index = <VI_PORT_INDEX>; \
			bus-width = <NUM_LANES>; \
			remote-endpoint = <&zedx_csi_out##ID>; \
		}; \
	};

#define ZEDX_CSI_CHANNEL(ID, REG_ID, CSI_PORT_INDEX) \
	channel@REG_ID { \
		reg = <REG_ID>; \
		ports { \
			#address-cells = <1>; \
			#size-cells = <0>; \
			port@0 { \
				reg = <0>; \
				zedx_csi_in##ID: endpoint@0 { \
					port-index = <CSI_PORT_INDEX>; \
					bus-width = <NUM_LANES>; \
					remote-endpoint = <&zedx_ar0234_out##ID>; \
				}; \
			}; \
			port@1 { \
				reg = <1>; \
				zedx_csi_out##ID: endpoint@1 { \
					remote-endpoint = <&zedx_vi_in##ID>; \
				}; \
			}; \
		}; \
	};

#define ZEDX_STEREO_SENSOR(SLOT, SIDE, UNIT_ADDR, REG_ADDR, DEVNODE, SYNC_NAME, SYNC_INDEX, ZEDX_ID, VC_ID, CSI_SERIAL, LANE_POLARITY, CSI_PORT_INDEX, OPT_CSI_PORT, OUT_ID) \
	zedx_##SIDE##SLOT: zedx_##SIDE##_##SLOT@UNIT_ADDR { \
		compatible = "stereolabs,zedx"; \
		reg = <REG_ADDR>; \
		ZED_ORIN_CLKS \
		devnode = DEVNODE; \
		sync_sensor = SYNC_NAME; \
		sync_sensor_index = <SYNC_INDEX>; \
		zedx-id = XSTR(ZEDX_ID); \
		channel = "a"; \
		has-eeprom; \
		eeprom-addr = <0x54>; \
		AR0234_MODES(XSTR(VC_ID), CSI_SERIAL, LANE_POLARITY) \
		ports { \
			#address-cells = <1>; \
			#size-cells = <0>; \
			port@0 { \
				reg = <0>; \
				zedx_ar0234_out##OUT_ID: endpoint { \
					vc-id = <VC_ID>; \
					port-index = <CSI_PORT_INDEX>; \
					opt-csi-port = OPT_CSI_PORT; \
					bus-width = <NUM_LANES>; \
					i2c-cc = <0>; \
					remote-endpoint = <&zedx_csi_in##OUT_ID>; \
				}; \
			}; \
		}; \
	};

#define ZEDX_ONE_GS_SENSOR(SLOT, UNIT_ADDR, REG_ADDR, DEVNODE, SYNC_NAME, ZEDX_ID, VC_ID, CSI_SERIAL, LANE_POLARITY, CSI_PORT_INDEX, OPT_CSI_PORT) \
	zedxone_gs##SLOT: zedxone_gs_##SLOT@UNIT_ADDR { \
		compatible = "stereolabs,zedx"; \
		reg = <REG_ADDR>; \
		ZED_ORIN_CLKS \
		devnode = DEVNODE; \
		sync_sensor = SYNC_NAME; \
		sync_sensor_index = <1>; \
		zedx-id = XSTR(ZEDX_ID); \
		channel = "a"; \
		has-eeprom; \
		eeprom-addr = <0x56>; \
		AR0234_MODES(XSTR(VC_ID), CSI_SERIAL, LANE_POLARITY) \
		ports { \
			#address-cells = <1>; \
			#size-cells = <0>; \
			port@0 { \
				reg = <0>; \
				zedxone_gs_out##SLOT: endpoint { \
					vc-id = <VC_ID>; \
					port-index = <CSI_PORT_INDEX>; \
					opt-csi-port = OPT_CSI_PORT; \
					bus-width = <NUM_LANES>; \
					i2c-cc = <0>; \
					remote-endpoint = <&zedxone_gs_csi_in##SLOT>; \
				}; \
			}; \
		}; \
	};

#define ZEDX_SERIALIZER(SLOT, UNIT_ADDR, REG_ADDR, ZEDX_ID) \
	zedx_ser##SLOT: zedx_ser_##SLOT@UNIT_ADDR { \
		compatible = "stereolabs,sl_max9295"; \
		reg = <REG_ADDR>; \
		zedx-id = XSTR(ZEDX_ID); \
		channel = "a"; \
		mode = "master"; \
		camera_model = "zedx"; \
		camera-sensors = <&zedx_left##SLOT &zedx_right##SLOT>; \
		imu = <&bmi088_a &bmi088_b>; \
	};

#define ZEDX_ONE_GS_SERIALIZER(SLOT, UNIT_ADDR, REG_ADDR, ZEDX_ID) \
	zedxone_gs_ser##SLOT: zedxone_gs_ser_##SLOT@UNIT_ADDR { \
		compatible = "stereolabs,sl_max9295"; \
		reg = <REG_ADDR>; \
		zedx-id = XSTR(ZEDX_ID); \
		channel = "a"; \
		mode = "master"; \
		camera_model = "zedonegs"; \
		camera-sensors = <&zedxone_gs##SLOT>; \
		imu = <&bmi088_a &bmi088_b>; \
	};

#define ZEDX_ONE_GS_VI_PORT(ID, UNIT_ADDR, REG_ID, VC_ID, VI_PORT_INDEX) \
	port@UNIT_ADDR { \
		reg = <REG_ID>; \
